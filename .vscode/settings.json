{
	"markdown.marp.themes": [
		"./marpx/themes/marpx.css",
		"./marpx/themes/cantor.css",
		"./marpx/themes/church.css",
		"./marpx/themes/copernicus.css",
		"./marpx/themes/einstein.css",
		"./marpx/themes/frankfurt.css",
		"./marpx/themes/galileo.css",
		"./marpx/themes/gauss.css",
		"./marpx/themes/gropius.css",
		"./marpx/themes/gödel.css",
		"./marpx/themes/haskell.css",
		"./marpx/themes/hobbes.css",
		"./marpx/themes/lorca.css",
		"./marpx/themes/newton.css",
		"./marpx/themes/socrates.css",
		"./marpx/themes/sparta.css"
	],
	"gitdoc.enabled": false,
	"cSpell.words": [
		"calloc",
		"cout",
		"endl",
		"malloc",
		"memcpy",
		"NRVO",
		"prvalue"
	],
	"workbench.colorTheme": "Markdown Editor Focus",
	"editor.minimap.enabled": false,
	"breadcrumbs.enabled": false,
	"editor.glyphMargin": false,
	"explorer.decorations.badges": false,
	"explorer.decorations.colors": false,
	"editor.fontLigatures": true,
	"files.autoSave": "afterDelay",
	"git.enableSmartCommit": true,
	"window.commandCenter": false,
	"editor.renderWhitespace": "none",
	"markdown.validate.enabled": true,
	"markdown.updateLinksOnFileMove.enabled": "prompt",
	"workbench.startupEditor": "none",
	"editor.fontFamily": "iA Writer Mono S",
	"editor.fontSize": 18,
	"editor.fontWeight": "350",
	"editor.formatOnSave": true,
	"editor.inlayHints.enabled": "on",
	"editor.lineHeight": 2.2,
	"workbench.tree.renderIndentGuides": "always",
	// zenMode settings
	"zenMode.showTabs": "none",
	"editor.scrollbar.vertical": "hidden",
	// "zenMode.fullScreen": false,
	"zenMode.restore": true,
	"zenMode.hideStatusBar": false,
	"zenMode.hideLineNumbers": false,
	"zenMode.centerLayout": true
	// vspacecode settings
}